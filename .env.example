# ─────────────────────────────────────────────────────────────────────────────
# Coordination Intelligence Platform PoC — environment configuration
# Copy to .env and fill in. NOTHING is hardcoded in app code; every external
# dependency is configured here so the PoC ports cleanly to production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neo4j (graph DB) ─────────────────────────────────────────────────────────
# Local: bolt://localhost:7687 (docker compose). Prod: your AuraDB neo4j+s URI.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword
NEO4J_DATABASE=neo4j

# ── LLM extraction (pluggable; default Claude) ───────────────────────────────
# LLM_PROVIDER selects the adapter in ingestion/cip_ingest/adapters:
#   anthropic     API key (ANTHROPIC_API_KEY). If no key is set AND the `claude`
#                 CLI is installed, this auto-falls-back to claude_cli below.
#   claude_cli    Claude Code CLI — uses your Claude *subscription*, no API key.
#                 Host-only (needs your `claude` login; not in the Docker container).
#   mock          deterministic offline extraction — no key, no cost (dev/CI/demo).
#   manual        writes prompts to paste into Claude Desktop; reads your replies.
#   openai | azure_openai   their respective keys below.
LLM_PROVIDER=anthropic
# Cost-conscious default: Sonnet 4.6 ($3/$15 per 1M tok) at medium effort.
# Bump to claude-opus-4-8 + LLM_EFFORT=high later if extraction quality needs it.
LLM_MODEL=claude-sonnet-4-6
# Effort (Anthropic only, GA): low | medium | high | max. Lower = cheaper/terser.
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Auth (Keycloak / OIDC; behind a swappable seam) ──────────────────────────
# For production, point these at the replacement IdP — app code is unchanged.
AUTH_PROVIDER=keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/platform
KEYCLOAK_CLIENT_ID=platform-web
KEYCLOAK_CLIENT_SECRET=
# NextAuth / Auth.js session secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# ── Read API ─────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:3000

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── No-API-key run artifacts (timestamped, gitignored) ───────────────────────
# claude_cli mode logs each call (command + prompt + raw output) here as
# <org>-YYYYMMDD-HHMM-<TZ>.md (local time; TZ = e.g. PDT/PST) so you can see
# what happened behind the scenes.
CLI_LOG_DIR=cli-runs
# manual mode writes prompts to paste into Claude Desktop here, grouped by run.
MANUAL_DIR=manual-runs

# ── Cloudflare Tunnel preview (optional; make up-tunnel) ─────────────────────
# Public HTTPS preview at cip-preview-web.sploosh.ai, cip-preview-auth.sploosh.ai,
# and cip-preview-neo4j.sploosh.ai — see docs/runbook.md, "Preview (Cloudflare
# Tunnel)" and docs/cloudflare/tunnel-setup.md for how the tunnel + its three
# routes were created. Leave unset for local-only work; `make up`/`up-web`
# never read this. The neo4j route has its own separate login (not Keycloak) —
# make sure NEO4J_PASSWORD below is a real value, not the local-dev default,
# before that route is actually safe to leave up.
TUNNEL_TOKEN=

# ── Profile images ───────────────────────────────────────────────────────────
# Host folder of user avatars, mounted read-only into the API at /srv/avatars.
# Leave UNSET to use the bundled ./assets/avatars. To override, use an ABSOLUTE
# path (a relative one resolves against infra/, not the repo root) — e.g. an
# external drive or a share exported from a Docker host / VM:
#   AVATARS_DIR=/Volumes/team-assets/avatars
# AVATARS_DIR=
