{
  "realm": "platform",
  "enabled": true,
  "displayName": "Coordination Intelligence Platform",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full access — manage data + users" },
      { "name": "analyst", "description": "Query the graph, view evidence" },
      { "name": "viewer", "description": "Read-only demo access" }
    ]
  },
  "clients": [
    {
      "clientId": "platform-web",
      "name": "Platform Web (Next.js)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://*.vercel.app/*",
        "https://cip-preview-web.sploosh.ai/*"
      ],
      "webOrigins": ["http://localhost:3000", "+"],
      "secret": "REPLACE_ME_IN_ENV",
      "attributes": { "post.logout.redirect.uris": "+" }
    }
  ],
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "users": [
    {
      "username": "demo-admin",
      "email": "demo-admin@example.invalid",
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ],
      "realmRoles": ["admin", "analyst"]
    },
    {
      "username": "demo-analyst",
      "email": "demo-analyst@example.invalid",
      "firstName": "Demo",
      "lastName": "Analyst",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ],
      "realmRoles": ["analyst"]
    }
  ]
}
