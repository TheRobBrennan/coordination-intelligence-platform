# data / scrape artifacts
ingestion/.cache/
ingestion/output/
*.local

# no-API-key run artifacts: keep the folders visible in the repo (.gitkeep),
# but ignore the timestamped prompt/response/log files inside them.
cli-runs/*
!cli-runs/.gitkeep
**/cli-runs/*
!**/cli-runs/.gitkeep
manual-runs/*
!manual-runs/.gitkeep
**/manual-runs/*
!**/manual-runs/.gitkeep
diagnostics/
**/diagnostics/

# os / editor
.DS_Store
.idea/
.vscode/
