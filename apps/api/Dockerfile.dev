# Dev image for the FastAPI read API. Pins Python 3.12 + uv so the host needs
# neither. Source is bind-mounted at runtime (see infra/docker-compose.yml) for
# hot reload; the virtualenv lives at /opt/venv, OUTSIDE the mount, so the host
# directory doesn't shadow installed dependencies.
FROM python:3.12-slim

# uv resolves/installs deps; keep the project venv off the bind-mounted /app.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir uv

WORKDIR /app

# Install deps first (better layer caching). Only pyproject is needed for a PoC
# with no lockfile yet; add uv.lock here later for reproducible builds.
COPY pyproject.toml ./
RUN uv sync --extra dev

# App code is bind-mounted over this at runtime; the COPY keeps the image usable
# standalone (e.g. CI) without a mount.
COPY . .

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
