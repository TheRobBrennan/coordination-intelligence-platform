# apps/web — env for native dev (pnpm dev:web). Copy to .env.local and fill in.
# Containerized (`make up-web`) gets these from the root .env / docker-compose.yml
# instead — see infra/docker-compose.yml's web service and ../.env.example.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Auth (Keycloak / OIDC) — see apps/web/src/auth.ts ────────────────────────
KEYCLOAK_ISSUER=http://localhost:8080/realms/platform
KEYCLOAK_CLIENT_ID=platform-web
# Matches the literal placeholder still baked into infra/keycloak/realm-export.json
# (it's imported verbatim, so this IS the real local-dev secret until rotated).
KEYCLOAK_CLIENT_SECRET=REPLACE_ME_IN_ENV

# NextAuth / Auth.js session secret (generate with: openssl rand -base64 32)
AUTH_SECRET=
