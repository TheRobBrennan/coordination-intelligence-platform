# Dev image for the Next.js UI. Pins Node 24.17.0 LTS (Krypton) + pnpm 10 via
# Corepack — matches the host .nvmrc / package.json so the container and your
# machine run the same toolchain. Source is bind-mounted at runtime; node_modules
# is an anonymous volume so the empty host folder doesn't shadow installed deps.
#
# NOTE: this builds only AFTER apps/web is scaffolded (create-next-app produces
# the package.json this expects). Until then the "web" compose profile is off by
# default, so `docker compose up` ignores this service.
FROM node:24.17.0-bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
# packageManager in package.json pins the exact pnpm version; Corepack honors it.
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate

WORKDIR /app

# Install deps first for layer caching (lockfile may not exist on first run).
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install

COPY . .

EXPOSE 3000
CMD ["pnpm", "dev"]
