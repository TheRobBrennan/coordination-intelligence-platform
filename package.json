{
  "name": "coordination-intelligence-platform",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Coordination Intelligence Platform — PoC monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRobBrennan/coordination-intelligence-platform.git"
  },
  "scripts": {
    "start": "make up-web",
    "start:web": "make up-web",
    "stop": "make down",
    "build": "make build",
    "clean": "make clean",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000",
    "dev:web": "pnpm --filter web dev",
    "test:web": "pnpm --filter web test"
  },
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.8.0"
}
